{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base",
      "description": "Shared settings for editor-first builds.",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${hostSystemName}/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ARTIFACT_ENABLE_EDITOR": "ON",
        "ARTIFACT_ENABLE_RUNTIME": "OFF",
        "ARTIFACT_ENABLE_TESTS": "OFF",
        "ARTIFACT_ENABLE_TRACY": "ON",
        "ARTIFACT_ENABLE_TOOLS": "OFF",
        "ARTIFACT_BUILD_PACKAGING": "OFF"
      }
    },
    {
      "name": "ninja-base",
      "displayName": "Ninja Base",
      "description": "Base configuration using Ninja (fast, works with most IDEs).",
      "inherits": "base",
      "hidden": true,
      "generator": "Ninja"
    },
    {
      "name": "Win64-Editor-Debug",
      "displayName": "Win64 Editor Debug",
      "description": "Debug build of the editor + tests using Ninja.",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Win64-Editor-RelWithDebInfo",
      "displayName": "Win64 Editor RelWithDebInfo",
      "description": "RelWithDebInfo editor build using Ninja (Tracy off by default).",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ARTIFACT_ENABLE_TRACY": "OFF"
      }
    },
    {
      "name": "Win64-Tests-Debug",
      "displayName": "Win64 Tests Debug",
      "description": "Debug build focused on the tests executable (runtime + tests enabled).",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ARTIFACT_ENABLE_RUNTIME": "ON",
        "ARTIFACT_ENABLE_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Build-Win64-Editor-Debug",
      "displayName": "Build Win64 Editor Debug",
      "configurePreset": "Win64-Editor-Debug"
    },
    {
      "name": "Build-Win64-Editor-RelWithDebInfo",
      "displayName": "Build Win64 Editor RelWithDebInfo",
      "configurePreset": "Win64-Editor-RelWithDebInfo"
    },
    {
      "name": "Build-Win64-Tests-Debug",
      "displayName": "Build Win64 Tests Debug",
      "configurePreset": "Win64-Tests-Debug"
    }
  ],
  "testPresets": [
    {
      "name": "Test-Win64-Editor-Debug",
      "displayName": "Test Win64 Editor Debug",
      "configurePreset": "Win64-Editor-Debug"
    },
    {
      "name": "Test-Win64-Tests-Debug",
      "displayName": "Test Win64 Tests Debug",
      "configurePreset": "Win64-Tests-Debug"
    }
  ]
}
