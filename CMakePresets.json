{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base",
      "description": "Shared settings for editor-first builds.",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ARTIFACT_ENABLE_EDITOR": "ON",
        "ARTIFACT_ENABLE_RUNTIME": "OFF",
        "ARTIFACT_ENABLE_TESTS": "ON",
        "ARTIFACT_ENABLE_TRACY": "ON",
        "ARTIFACT_ENABLE_TOOLS": "OFF",
        "ARTIFACT_BUILD_PACKAGING": "OFF"
      }
    },
    {
      "name": "editor-debug",
      "displayName": "Editor Debug",
      "description": "Debug build of the editor + tests for the current host.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "editor-release",
      "displayName": "Editor Release",
      "description": "RelWithDebInfo editor build (Tracy off by default).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ARTIFACT_ENABLE_TRACY": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-editor-debug",
      "displayName": "Build editor debug",
      "configurePreset": "editor-debug"
    },
    {
      "name": "build-editor-release",
      "displayName": "Build editor release",
      "configurePreset": "editor-release"
    }
  ],
  "testPresets": [
    {
      "name": "test-editor",
      "displayName": "Test editor debug",
      "configurePreset": "editor-debug"
    }
  ]
}
