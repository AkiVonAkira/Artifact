{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base",
      "description": "Base settings for all configurations (IDE-agnostic)",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ARTIFACT_ENABLE_EDITOR": "ON",
        "ARTIFACT_ENABLE_RUNTIME": "OFF",
        "ARTIFACT_ENABLE_TESTS": "OFF",
        "ARTIFACT_ENABLE_TRACY": "ON",
        "ARTIFACT_ENABLE_TOOLS": "OFF",
        "ARTIFACT_BUILD_PACKAGING": "OFF"
      }
    },
    {
      "name": "toolchain-vcpkg",
      "displayName": "vcpkg Toolchain (optional)",
      "description": "Use vcpkg toolchain if VCPKG_ROOT is set",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{VCPKG_ROOT}",
        "rhs": ""
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Generic Debug configuration (generator chosen by IDE or CLI)",
      "inherits": ["base", "toolchain-vcpkg"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Generic Release configuration",
      "inherits": ["base", "toolchain-vcpkg"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ARTIFACT_ENABLE_TRACY": "OFF"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "description": "Generic RelWithDebInfo configuration",
      "inherits": ["base", "toolchain-vcpkg"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ARTIFACT_ENABLE_TRACY": "OFF"
      }
    },
    {
      "name": "tests-debug",
      "displayName": "Tests Debug",
      "description": "Debug configuration focused on tests (heavy components off)",
      "inherits": ["debug"],
      "cacheVariables": {
        "ARTIFACT_ENABLE_EDITOR": "OFF",
        "ARTIFACT_ENABLE_RUNTIME": "OFF",
        "ARTIFACT_ENABLE_TESTS": "ON",
        "ARTIFACT_ENABLE_TOOLS": "OFF",
        "ARTIFACT_BUILD_PACKAGING": "OFF",
        "ARTIFACT_ENABLE_TRACY": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-build",
      "displayName": "Build Debug",
      "configurePreset": "debug"
    },
    {
      "name": "release-build",
      "displayName": "Build Release",
      "configurePreset": "release"
    },
    {
      "name": "relwithdebinfo-build",
      "displayName": "Build RelWithDebInfo",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "tests-debug-build",
      "displayName": "Build Tests (Debug)",
      "configurePreset": "tests-debug"
    }
  ],
  "testPresets": [
    {
      "name": "tests-debug-ctest",
      "displayName": "Run tests (Debug)",
      "configurePreset": "tests-debug"
    }
  ]
}
